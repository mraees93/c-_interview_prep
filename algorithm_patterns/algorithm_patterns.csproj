<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- This tells .NET to completely ignore these folders during build -->
    <!-- This single line tells .NET 10 to ignore those folders perfectly -->
    <DefaultItemExcludes>$(DefaultItemExcludes);binary_search/**;two_pointers/**;sliding_window/**</DefaultItemExcludes>
  </PropertyGroup>

</Project>
